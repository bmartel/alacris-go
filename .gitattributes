# Normalise everything to LF in the repository and in the working tree, so a
# Windows checkout and a Linux one produce identical bytes.
* text=auto eol=lf

*.go     text eol=lf
*.js     text eol=lf
*.templ  text eol=lf
*.md     text eol=lf
*.yml    text eol=lf

# The vendored alacris runtime and @alacris/ui sources are byte-pinned by
# assets_test.go, so git must not touch them at all. This rule is last on
# purpose: for attributes, the last matching pattern wins, and it has to beat
# the *.js rule above.
/assets/** -text

# Generated Go is checked in and diffed by `alacris-go check`; collapsing it in
# review keeps a regenerate from burying a real change.
*_gen.go     linguist-generated=true
*_templ.go   linguist-generated=true

# This is a Go module. The vendored runtime is someone else's build and the
# documentation site is a site, so neither should count towards the repository's
# language statistics.
/assets/**   linguist-vendored=true
/docs/**     linguist-documentation=true
