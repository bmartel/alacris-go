---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caption =
	'The example app: a live Kanban board. Cards keep the same DOM nodes as they move; the server writes props, not HTML.';
---

<figure class="guide-hero" style={`--hero-poster: url('${base}/board-hero.jpg')`}>
	<video
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster={`${base}/board-hero.jpg`}
	>
		<source src={`${base}/board-hero.webm`} type="video/webm" />
	</video>
	<figcaption>{caption}</figcaption>
</figure>

<style>
	@media (prefers-reduced-motion: reduce) {
		.guide-hero video {
			display: none;
		}
		.guide-hero {
			min-height: 12rem;
			background: center 28% / cover no-repeat var(--hero-poster);
		}
		.guide-hero figcaption {
			background: rgb(12 10 6 / 0.72);
		}
	}
</style>
