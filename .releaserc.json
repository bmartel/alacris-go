{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "//": "While this module is below 1.0.0, a breaking change is a minor bump rather than a major one: 0.1.2 -> 0.2.0, not 1.0.0. semver.inc would otherwise take the first breaking change straight to 1.0.0, which would declare a stability this API has not earned. User rules are evaluated before the defaults, so this one wins over the built-in major. REMOVE IT when cutting 1.0.0, or breaking changes will stay minor forever.",
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "test", "release": false },
          { "type": "build", "release": false },
          { "type": "ci", "release": false },
          { "type": "chore", "release": false }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance" },
            { "type": "refactor", "section": "Refactoring" },
            { "type": "revert", "section": "Reverts" },
            { "type": "docs", "section": "Documentation", "hidden": true },
            { "type": "test", "section": "Tests", "hidden": true },
            { "type": "build", "section": "Build", "hidden": true },
            { "type": "ci", "section": "CI", "hidden": true },
            { "type": "chore", "section": "Chores", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project are documented here. Releases are cut\nautomatically by [semantic-release](https://semantic-release.gitbook.io/) from\n[Conventional Commits](https://www.conventionalcommits.org/)."
      }
    ],
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false,
        "failCommentCondition": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
