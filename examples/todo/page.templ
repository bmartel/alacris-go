package main

import (
	"strconv"

	alacris "github.com/bmartel/alacris-go"
	"github.com/bmartel/alacris-go/examples/todo/ui"
	m3 "github.com/bmartel/alacris-go/ui"
)

// page is the whole document.
//
// Everything below the <body> is one render. There is no hydration payload and
// no serialized component state: the elements carry their props as attributes,
// and alacris builds their shadow content when the module arrives.
//
// Chrome is Alacris UI, composed inside the board: title, filter, members and
// share sit in a padded header so they are not jammed against the viewport.
templ page(v view) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>alacris-go — board</title>
			@alacris.Pending{Tags: ui.Tags}
			@m3.Pending()
			@alacris.Scripts(v.Config)
			@styles()
		</head>
		<body>
			<div class="workspace">
				@ui.Board(ui.BoardProps{Title: "Ship it", Items: v.Items, Columns: v.Columns}).
					ID(boardID).
					On(ui.BoardEventAdd, actionAdd).
					On(ui.BoardEventMove, actionMove).
					On(ui.BoardEventAddlist, actionAddList).
					On(ui.BoardEventMovelist, actionMoveList).
					On(ui.BoardEventRename, actionRenameList).
					On(ui.BoardEventDeletelist, actionDeleteList).
					On(ui.BoardEventEdit, actionEdit).
					On(ui.BoardEventRemove, actionRemove) {
					<span slot={ ui.BoardSlotEmpty }></span>
					<div id={ membersID } class="facepile" slot={ ui.BoardSlotMembers }>
						if v.Desktop {
							@m3.Button(m3.ButtonProps{Variant: "text"}).ID("export").On("click", actionExport) {
								Export
							}
						}
						@facepile(v.Members, len(v.Items))
					</div>
				}
			</div>
		</body>
	</html>
}

templ facepile(names []string, cards int) {
	<span data-cards={ strconv.Itoa(cards) }></span>
	for _, name := range names {
		@m3.Avatar(m3.AvatarProps{Name: name, Size: "32px", Label: name})
	}
}

templ styles() {
	<style>
		html, body {
			margin: 0;
			height: 100%;
			height: 100dvh;
			overflow: hidden;
			background: var(--ui-color-surface);
			color: var(--ui-color-on-surface);
		}
		body {
			display: flex;
			flex-direction: column;
			min-height: 100%;
			min-height: 100dvh;
		}
		.workspace {
			flex: 1;
			min-height: 0;
			display: flex;
			flex-direction: column;
		}
		#board {
			flex: 1;
			min-height: 0;
		}
		.facepile {
			display: flex;
			align-items: center;
			padding-inline: 4px;
		}
		.facepile ui-avatar {
			margin-inline-start: -8px;
			box-shadow: 0 0 0 2px var(--ui-color-surface-container);
		}
		.facepile ui-avatar:first-of-type { margin-inline-start: 0; }
		.facepile [data-cards] { display: none }
	</style>
}
