package main

import (
	alacris "github.com/bmartel/alacris-go"
	"github.com/bmartel/alacris-go/examples/todo/ui"
	m3 "github.com/bmartel/alacris-go/ui"
)

// page is the whole document.
//
// Everything below the <body> is one render. There is no hydration payload and
// no serialized component state: the elements carry their props as attributes,
// and alacris builds their shadow content when the module arrives.
templ page(v view) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>alacris-go — todos</title>
			// Hide the elements until they are defined. Their shadow content
			// is built in the browser, so without this the page paints empty
			// shells first and then fills them in.
			@alacris.Pending{Tags: ui.Tags}
			@m3.Pending()
			// The import map has to come before any module import.
			@alacris.Scripts(v.Config)
			@styles()
		</head>
		<body>
			<main>
				<header>
					<h1>Todos</h1>
					<p class="tag">
						The list lives on the server. Every change below is one
						property write — no HTML on the wire.
					</p>
				</header>

				<section>
					<h2>
						Server-owned list
						@ui.Chip(ui.ChipProps{}).ID(countsID).
							Apply(ui.ChipVars, map[string]string{"--chip-bg": "#ffe9a8"}) {
							{ v.RemainingLabel() }
						}
					</h2>

					// Props go down; events come back up as named server
					// actions. The element needs an id because that is what a
					// patch addresses.
					@ui.TodoList(ui.TodoListProps{
						Items:  v.Items,
						Filter: v.Filter,
					}).
						ID(todosID).
						On(ui.TodoListEventAdd, actionAdd).
						On(ui.TodoListEventToggle, actionToggle).
						On(ui.TodoListEventRemove, actionRemove).
						On(ui.TodoListEventFilter, actionFilter) {
						<p slot={ ui.TodoListSlotEmpty } class="empty">
							Nothing here. Add something above.
						</p>
					}

					<p class="note">
						Open this page in a second tab. Both stay in step,
						because both are looking at the same list.
					</p>
				</section>

				<section>
					<h2>Browser-owned counter</h2>
					// The counter keeps its own state; the server only hears
					// about it because this element asked it to.
					@ui.Counter(ui.CounterProps{Start: 3}).
						ID("counter").
						On(ui.CounterEventChange, actionCount)
					<p class="note">
						Last value the server saw:
						@ui.Chip(ui.ChipProps{}).ID(echoID) {
							never
						}
					</p>
				</section>
			</main>
		</body>
	</html>
}

// chipText is what the server pushes into a chip's default slot.
templ chipText(s string) {
	<span>{ s }</span>
}

templ styles() {
	<style>
		:root {
			color-scheme: light dark;
			--bg: #fbfbfd; --fg: #16161a; --mut: #6b6b76;
			--line: #e3e3ea; --accent: #ffb300; --card: #fff;
		}
		@media (prefers-color-scheme: dark) {
			:root {
				--bg: #101013; --fg: #eeeef2; --mut: #9a9aa6;
				--line: #2a2a32; --accent: #ffc233; --card: #18181d;
			}
		}
		* { box-sizing: border-box }
		body {
			margin: 0; padding: 2.5rem 1.25rem 5rem;
			background: var(--bg); color: var(--fg);
			font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
		}
		main { max-width: 42rem; margin: 0 auto }
		h1 { font-size: 2.2rem; margin: 0 0 .2rem; letter-spacing: -.03em }
		h2 {
			font-size: .8rem; text-transform: uppercase; letter-spacing: .09em;
			color: var(--mut); margin: 0 0 1rem; font-weight: 600;
			display: flex; align-items: center; gap: .5rem;
		}
		.tag { color: var(--mut); margin: 0 0 2.5rem }
		.note { color: var(--mut); font-size: .85rem; margin: 1rem 0 0 }
		.empty { color: var(--mut); margin: 0 }
		section {
			border: 1px solid var(--line); border-radius: 14px;
			padding: 1.25rem 1.4rem 1.5rem; margin-bottom: 1.25rem;
			background: var(--card);
		}
		/* Themed from outside the shadow root, which is the whole point of
		   the custom properties the component declares with vars(). */
		ala-chip { --chip-bg: #ececf2; --chip-fg: #333 }
		@media (prefers-color-scheme: dark) {
			ala-chip { --chip-bg: #2b2b33; --chip-fg: #eee }
		}
	</style>
}
